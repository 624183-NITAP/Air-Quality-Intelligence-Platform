# AeroPulse 2.0 Environment Configuration Template
# Copy this file to .env or configure in your deployment environment.
# Note: AeroPulse includes a complete deterministic atmospheric physics & aerosol mass-balance engine
# that runs 100% offline without requiring any external API key.

# Server-Side Google Gemini API Key
# Used exclusively by the server proxy (/api/gemini) or Node backend.
# IMPORTANT: Never prefix server secrets with VITE_ to prevent client bundle leakage.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
